# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign/verify JWTs. Use a long random value; never commit the
# real secret to version control.
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime (e.g. 1d, 12h, 60m).
JWT_EXPIRES_IN=1d
# Extra pepper appended to passwords before hashing (bcrypt).
BCRYPT_SECRET=replace-with-a-random-pepper

# ---------------------------------------------------------------------------
# Predefined single business-owner account (used by the seed script)
# Provide ADMIN_EMAIL and/or ADMIN_MOBILE as the login identifier.
# Set these to real values only in your local .env, never in this example file.
# ---------------------------------------------------------------------------
ADMIN_NAME=Business Owner
ADMIN_EMAIL=owner@example.com
ADMIN_MOBILE=01712345678
ADMIN_PASSWORD=ChangeMe@123

# ---------------------------------------------------------------------------
# Redis (required by other, non-auth modules)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# AI analysis (optional)
# Used only by the /api/ai endpoints for read-only business insights. Core ERP
# operations (stock, invoices, totals) never depend on AI. Leave unset to
# disable AI endpoints (they return 503 instead of failing the app).
# ---------------------------------------------------------------------------
# One of: openai | anthropic | google | openai-compatible
AI_PROVIDER=openai
# Model id understood by the chosen provider (e.g. gpt-4o-mini).
AI_MODEL=
# Required for AI_PROVIDER=openai-compatible (OpenRouter, Groq, local, ...).
AI_BASE_URL=
# Provider keys — set only the one matching AI_PROVIDER.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_API_KEY=
